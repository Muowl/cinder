{
  "$description": "Cinder Design System — Semantic tokens (dark). Implementations (VS Code, JetBrains, terminals, Obsidian, web, desktop) map their platform keys to THESE tokens, never to foundation scales or raw hex. Alpha variants are expressed as 8-digit hex derived from the referenced foundation color.",
  "background": {
    "default": {
      "$value": "{color.ash.950}",
      "$description": "Char — editor / main canvas"
    },
    "subtle": {
      "$value": "{color.ash.975}",
      "$description": "Soot — recessed chrome: sidebars, panels, wells"
    },
    "elevated": {
      "$value": "{color.ash.900}",
      "$description": "Coal — cards, popups, widgets one layer up"
    },
    "overlay": {
      "$value": "{color.ash.800}",
      "$description": "Basalt — topmost layers: menus, tooltips, command palette"
    }
  },
  "surface": {
    "default": {
      "$value": "{color.ash.900}",
      "$description": "Resting interactive surface"
    },
    "secondary": {
      "$value": "{color.ash.800}",
      "$description": "Hover / secondary emphasis"
    },
    "tertiary": {
      "$value": "{color.ash.700}",
      "$description": "Active / pressed / selected chrome"
    }
  },
  "border": {
    "subtle": {
      "$value": "{color.ash.800}",
      "$description": "Hairlines inside a surface; barely-there separation"
    },
    "default": {
      "$value": "{color.ash.700}",
      "$description": "Standard component and pane borders"
    },
    "strong": {
      "$value": "{color.ash.600}",
      "$description": "Focused inputs, resize handles, emphasis"
    },
    "control": {
      "$value": "{color.ash.400}",
      "$description": "Visible input boundaries; decorative separators remain quieter."
    },
    "focus": {
      "$value": "{color.ember.400}",
      "$description": "Keyboard focus indicator."
    }
  },
  "text": {
    "primary": {
      "$value": "{color.ash.100}",
      "$description": "Parchment — body text and code, 14.0:1 on background.default"
    },
    "secondary": {
      "$value": "{color.ash.300}",
      "$description": "Sandstone — supporting text, 7.1:1"
    },
    "muted": {
      "$value": "{color.ash.350}",
      "$description": "Linen - readable supporting text on dark surfaces."
    },
    "disabled": {
      "$value": "{color.ash.500}",
      "$description": "Dust — 3.0:1, intentionally sub-AA; must never carry essential info"
    },
    "auxiliary": {
      "$value": "{color.ash.350}",
      "$description": "CodeLens, hints, line numbers and suggested text; never the disabled token."
    }
  },
  "accent": {
    "primary": {
      "$value": "{color.ember.400}",
      "$description": "Ember — the brand color: focus, primary actions, active states"
    },
    "secondary": {
      "$value": "{color.gold.400}",
      "$description": "Brass — secondary emphasis, badges, counters"
    },
    "tertiary": {
      "$value": "{color.garnet.400}",
      "$description": "Rust — rare, deliberate warm emphasis"
    }
  },
