{
  "name": "cinder-design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check && node scripts/validate.mjs",
    "check:languages": "node scripts/language-qa.mjs",
    "qa:languages": "node scripts/language-qa.mjs --write",
    "qa:capture": "node scripts/capture-language-qa.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "npm run build && npm run check && npm --prefix vscode run package"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "shiki": "4.5.0"
  }
}
